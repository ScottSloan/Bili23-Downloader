          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login Status",
        "tags": [
          "login"
        ]
      }
    },
    "/api/parse": {
      "post": {
        "description": "解析一个链接，返回剧集树\n\n树的叶子节点带 `episode` 字段 —— 那正是创建下载任务时要交回来的东西，\n前端原样回传即可，不必自己拼",
        "operationId": "parse_url_api_parse_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Parse Url",
        "tags": [
          "parse"
        ]
      }
    },
    "/api/parse/episodes": {
      "post": {
        "description": "从解析树里把叶子摘出来\n\n前端完全可以自己遍历，这里提供一份是为了**让摘取规则只有一处**：\n树节点（`is_node`）不算下载项，这条规则改了两边就会对不上",
        "operationId": "extract_episodes_api_parse_episodes_post",
        "parameters": [
          {
            "in": "query",
            "name": "only_checked",
            "required": false,
            "schema": {
              "default": true,
              "title": "Only Checked",
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "title": "Tree",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Extract Episodes",
        "tags": [
          "parse"
        ]
      }
    },
